{
  "name": "passport-photo-app",
  "version": "1.0.1",
  "description": "Passport photo creation and print utility",
  "author": "AJtati",
  "private": true,
  "main": "electron/main.js",
  "homepage": ".",
  "dependencies": {
    "@capacitor/android": "^4.8.2",
    "@capacitor/cli": "^4.8.2",
    "@capacitor/core": "^4.8.2",
    "@capacitor/filesystem": "^4.1.5",
    "@capacitor/ios": "^4.8.2",
    "@capacitor/share": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.3.8",
    "changedpi": "^1.0.4",
    "jspdf": "^4.0.0",
    "konva": "^10.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "react-image-crop": "^11.0.10",
    "react-konva": "^19.2.2",
    "react-scripts": "5.0.1",
    "use-image": "^1.1.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "cross-env PORT=3000 react-scripts start",
    "build": "react-scripts build",
    "electron:start": "npm run build && electron .",
    "electron:dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "electron:dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip",
    "electron:dist:mac:arm64": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run ios:sync"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "gh-pages": "^6.3.0"
  },
  "build": {
    "extends": null,
    "appId": "com.ajtati.passportphoto",
    "productName": "Passport Photo App",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.photography",
      "icon": "electron/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
